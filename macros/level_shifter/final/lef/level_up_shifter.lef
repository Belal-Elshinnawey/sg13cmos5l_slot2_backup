        RECT -3.750 -11.095 13.110 14.970 ;
      LAYER Metal1 ;
        RECT -3.750 -11.095 13.110 14.970 ;
      LAYER Metal2 ;
        RECT -2.475 6.095 11.835 14.945 ;
        RECT -2.475 1.715 5.310 6.095 ;
        RECT 6.170 1.715 11.835 6.095 ;
        RECT -2.475 -4.690 11.835 1.715 ;
        RECT -2.475 -7.560 6.900 -4.690 ;
        RECT 8.420 -7.560 11.835 -4.690 ;
        RECT -2.475 -11.045 11.835 -7.560 ;
      LAYER Metal3 ;
        RECT -2.475 -11.045 11.835 14.945 ;
      LAYER Metal4 ;
        RECT -1.595 10.205 13.140 13.710 ;
        RECT -1.595 1.235 13.140 7.785 ;
        RECT -1.595 -9.050 13.140 -3.185 ;
  END
END level_up_shifter
