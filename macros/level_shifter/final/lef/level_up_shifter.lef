VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO level_up_shifter
  CLASS BLOCK ;
  FOREIGN level_up_shifter ;
  ORIGIN 3.880 11.335 ;
  SIZE 17.120 BY 27.255 ;
  PIN A
    ANTENNAGATEAREA 0.260000 ;
    PORT
      LAYER Metal2 ;
        RECT 7.110 -7.350 8.210 -4.900 ;
    END
  END A
  PIN B
    ANTENNAGATEAREA 2.000000 ;
    ANTENNADIFFAREA 4.080000 ;
    PORT
      LAYER Metal2 ;
        RECT 5.520 1.925 5.960 5.885 ;
    END
  END B
  PIN VDD1
    ANTENNAGATEAREA 0.260000 ;
    ANTENNADIFFAREA 9.780000 ;
    PORT
      LAYER Metal4 ;
        RECT -3.780 -11.260 13.140 -9.260 ;
    END
  END VDD1
  PIN VDD2
    ANTENNAGATEAREA 1.500000 ;
    ANTENNADIFFAREA 18.170000 ;
    PORT
      LAYER Metal4 ;
        RECT -3.780 7.995 13.140 9.995 ;
    END
